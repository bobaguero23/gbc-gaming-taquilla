{
  "appId": "com.gbcgaming.taquilla",
  "productName": "GBC Gaming",
  "asar": true,
  "directories": {
    "output": "dist-gbc"
  },
  "extraMetadata": {
    "name": "gbc-gaming",
    "productName": "GBC Gaming",
    "description": "GBC Gaming - Taquilla de Ganador",
    "author": "GBC Gaming"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.html",
    "dist/**/*.css",
    "dist/**/*.ttf",
    "dist/**/*.woff",
    "dist/**/*.woff2",
    "dist/**/*.eot",
    "dist/**/*.svg",
    "dist/**/*.png",
    "dist/**/*.jpg",
    "dist/**/*.gif",
    "dist/src/**/*",
    "public/electron.js",
    "public/tabbar.html",
    "public/icon.ico",
    "public/icon.png",
    "package.json",
    "!dist/win-unpacked",
    "!dist/win-unpacked/**/*",
    "!dist/*.exe",
    "!dist/*.blockmap",
    "!dist/*.yml",
    "!dist/builder-debug.yml",
    "!dist/.icon-ico",
    "!**/node_modules/**/*",
    "node_modules/electron-updater/**/*",
    "node_modules/builder-util-runtime/**/*",
    "node_modules/lazy-val/**/*",
    "node_modules/semver/**/*",
    "node_modules/lodash.isequal/**/*",
    "node_modules/js-yaml/**/*",
    "node_modules/argparse/**/*",
    "node_modules/sax/**/*",
    "node_modules/tiny-typed-emitter/**/*",
    "node_modules/fs-extra/**/*",
    "node_modules/graceful-fs/**/*",
    "node_modules/jsonfile/**/*",
    "node_modules/universalify/**/*",
    "node_modules/debug/**/*",
    "node_modules/ms/**/*",
    "node_modules/lodash.escaperegexp/**/*",
    "node_modules/esprima/**/*",
    "node_modules/sprintf-js/**/*"
  ],
  "extraResources": [
    {
      "from": "public/app-update.gbc.yml",
      "to": "app-update.yml"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "bobaguero23",
      "repo": "gbc-gaming-taquilla",
      "private": false
    }
  ],
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
