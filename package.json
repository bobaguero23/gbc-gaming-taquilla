{
  "name": "gbc-gaming",
  "description": "GBC Gaming - taquilla de Ganador",
  "author": "GBC Gaming",
  "homepage": "",
  "version": "1.0.1",
  "license": "MIT",
  "scripts": {
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && rimraf dist && webpack --config webpack.config.prod.js",
    "build:gbc": "set TAQUILLA_PRODUCT=gbc&& set NODE_OPTIONS=--openssl-legacy-provider&& rimraf dist && webpack --config webpack.config.prod.js",
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && webpack-dev-server --config webpack.config.dev.js",
    "start:gbc": "set TAQUILLA_PRODUCT=gbc&& set NODE_OPTIONS=--openssl-legacy-provider&& webpack-dev-server --config webpack.config.dev.js",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:8080 && electron .\"",
    "electron-dev:gbc": "set TAQUILLA_PRODUCT=gbc&& concurrently \"npm run start:gbc\" \"wait-on http://localhost:8080 && electron .\"",
    "electron-build": "npm run build && electron-builder build --win --publish never",
    "electron-build:gbc": "npm run build:gbc && electron-builder build --win --publish never --config electron-builder.gbc.json",
    "electron-pack": "npm run electron-build:gbc",
    "lint": "eslint \"src/**/*.js\""
  },
  "main": "public/electron.js",
  "build": {
    "appId": "com.gbcgaming.taquilla",
    "productName": "GBC Gaming",
    "asar": true,
    "files": [
      "dist/**/*.js",
      "dist/**/*.html",
      "dist/**/*.css",
      "dist/**/*.ttf",
      "dist/**/*.woff",
      "dist/**/*.woff2",
      "dist/**/*.eot",
      "dist/**/*.svg",
      "dist/**/*.png",
      "dist/**/*.jpg",
      "dist/**/*.gif",
      "dist/src/**/*",
      "public/electron.js",
      "public/tabbar.html",
      "public/icon.ico",
      "public/icon.png",
      "package.json",
      "!dist/win-unpacked",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/*.yml",
      "!dist/builder-debug.yml",
      "!dist/.icon-ico",
      "!**/node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/semver/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/sax/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/esprima/**/*",
      "node_modules/sprintf-js/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "public/app-update.gbc.yml",
        "to": "app-update.yml"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bobaguero23",
        "repo": "gbc-gaming-taquilla",
        "private": false
      }
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.15",
    "@fortawesome/free-solid-svg-icons": "^5.7.2",
    "@fortawesome/react-fontawesome": "^0.1.4",
    "@sentry/browser": "^5.12.4",
    "apollo-cache-inmemory": "^1.6.6",
    "apollo-client": "^2.6.10",
    "apollo-link": "^1.2.14",
    "apollo-link-error": "^1.1.13",
    "apollo-link-http": "^1.5.17",
    "apollo-link-ws": "^1.0.20",
    "apollo-utilities": "^1.3.4",
    "axios": "^0.19.2",
    "bootstrap": "^4.3.1",
    "clean-webpack-plugin": "^1.0.1",
    "date-and-time": "^0.6.3",
    "date-arithmetic": "^3.1.0",
    "detect-browser": "^4.1.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.7.3",
    "globalize": "^1.4.0",
    "graphql": "^15.3.0",
    "graphql-tag": "^2.11.0",
    "history": "^4.6.3",
    "i": "^0.3.6",
    "is-empty": "^1.2.0",
    "jwt-decode": "^2.2.0",
    "local-ip-url": "^1.0.1",
    "md5": "^2.2.1",
    "moment": "^2.23.0",
    "moment-timezone": "^0.5.31",
    "npm": "^6.8.0",
    "query-string": "^6.14.1",
    "react": "^16.7.0",
    "react-apollo": "^3.1.5",
    "react-barcode": "^1.3.4",
    "react-bootstrap": "^1.0.0-beta.5",
    "react-bootstrap-dialog": "^0.13.0",
    "react-countdown": "^2.2.1",
    "react-csv": "^1.0.19",
    "react-datepicker": "^2.1.0",
    "react-dom": "^16.7.0",
    "react-easy-print": "^0.6.0",
    "react-form-validator-core": "^0.6.2",
    "react-horizontal-scrolling-menu": "^0.7.10",
    "react-loading-skeleton": "^3.3.1",
    "react-number-format": "^4.9.4",
    "react-paginating": "^1.2.1",
    "react-recaptcha-google": "^1.1.1",
    "react-redux": "^5.1.1",
    "react-router-bootstrap": "^0.24.4",
    "react-router-dom": "^4.3.1",
    "react-select": "^4.3.1",
    "react-spinners": "^0.5.1",
    "react-toastify": "^4.5.2",
    "react-transition-group": "^4.4.4",
    "recaptcha-v3": "^1.7.2",
    "redux": "^3.7.2",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.2.0",
    "redux-zero": "^4.15.2",
    "regenerator-runtime": "^0.13.1",
    "save": "^2.4.0",
    "socket.io-client": "^4.6.1",
    "style-loader": "^0.23.1",
    "subscriptions-transport-ws": "^0.9.18",
    "underscore": "^1.10.2",
    "url-loader": "^1.1.2",
    "validator": "^10.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@babel/eslint-parser": "^7.25.8",
    "@babel/plugin-proposal-class-properties": "^7.2.3",
    "@babel/plugin-transform-arrow-functions": "^7.2.0",
    "@babel/plugin-transform-runtime": "^7.2.0",
    "@babel/preset-env": "^7.2.3",
    "@babel/preset-react": "^7.0.0",
    "babel-loader": "^8.0.5",
    "concurrently": "^9.2.1",
    "css-loader": "^2.1.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "enzyme": "^3.8.0",
    "enzyme-adapter-react-15": "^1.2.0",
    "enzyme-adapter-react-16": "^1.7.1",
    "eslint": "^8.38.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^3.0.1",
    "html-webpack-plugin": "^3.2.0",
    "path": "^0.12.7",
    "react-addons-test-utils": "^15.6.2",
    "react-test-renderer": "^16.7.0",
    "redux-mock-store": "^1.5.3",
    "wait-on": "^9.0.3",
    "webpack": "^4.28.4",
    "webpack-cli": "^3.2.1",
    "webpack-dev-server": "^3.1.4",
    "webpack-merge": "^4.2.1"
  }
}